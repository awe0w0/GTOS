# Preserve exact pinned upstream blobs and their original whitespace.
include/storage/littlefs/lfs.h -text -whitespace
include/storage/littlefs/lfs_util.h -text -whitespace
src/storage/littlefs/lfs.c -text -whitespace
src/storage/littlefs/lfs_util.c -text -whitespace
docs/littlefs/LICENSE.md -text -whitespace
# Keep the qualified manifest's CRLF bytes and validate other whitespace normally.
apps/native_scanf/input-manifest.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Keep the offline DUP source lock and recorded evidence bytes exact.
tools/native_dup/inputs.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tests/native_dup/verification.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve the qualified directory capsule and original evidence bytes.
apps/native_directory/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve event capsule hashes, including CRLF JSON manifests.
apps/native_events/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve the startup/CPU capsule hashes using the existing event convention.
apps/native_environment/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve the native base-class sources and qualified evidence bytes.
apps/native_base_classes/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
