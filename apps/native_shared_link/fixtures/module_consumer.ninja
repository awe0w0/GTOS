defines = -D__GTOS__=1
include_dirs = -I../source
cflags = -fPIC
cflags_c =
label_name = module_consumer
root_out_dir = .
target_out_dir = obj/tools/gtos_shared_link_qualification
target_output_name = libmodule_consumer

build obj/tools/gtos_shared_link_qualification/libmodule_consumer.module-consumer.o: cc ../source/tools/gtos_shared_link_qualification/module-consumer.c | ../source/build/config/unsafe_buffers_paths.txt ../source/build/config/raw_ptr_plugin_config.yaml
  source_file_part = module-consumer.c
  source_name_part = module-consumer

build ./libmodule_consumer.so: solink_module obj/tools/gtos_shared_link_qualification/libmodule_consumer.module-consumer.o ./libshared_values.so | ../source/build/config/unsafe_buffers_paths.txt ../source/build/config/raw_ptr_plugin_config.yaml
  ldflags =
  libs =
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
