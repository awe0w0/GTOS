@@ -639,6 +645,16 @@ OPENSSL_EXPORT int CRYPTO_refcount_dec_and_test_zero(CRYPTO_refcount_t *count);
 // A Mutex is a read/write lock. It can be constant-initialized, but has a
 // destructor. To allocate a global one, use StaticMutex, which skips the
 // destructor.
+#if defined(OPENSSL_GTOS_THREADS)
+struct GtosReadWriteLock {
+  std::atomic<uint32_t> gate{0};
+  uint32_t next_ticket = 0, serving_ticket = 0, writer = 0;
+  struct Reader {
+    uint32_t owner = 0, depth = 0;
+  } readers[4] = {};
+};
+#endif
+
 class OPENSSL_EXPORT StaticMutex {
  public:
   constexpr StaticMutex() = default;
@@ -660,6 +676,8 @@ class OPENSSL_EXPORT StaticMutex {
 protected:
 #if !defined(OPENSSL_THREADS)
   // Nothing.
+#elif defined(OPENSSL_GTOS_THREADS)
+  GtosReadWriteLock lock_;
 #elif defined(OPENSSL_WINDOWS_THREADS)
   SRWLOCK lock_ = SRWLOCK_INIT;
