--- a/third_party/libxml/BUILD.gn
+++ b/third_party/libxml/BUILD.gn
@@ -4,12 +4,24 @@
 
 # Define an "os_include" variable that points at the OS-specific generated
 # headers.  These were generated by running the configure script offline.
+declare_args() {
+  gtos_libxml_config_dir = ""
+}
+
 if (is_linux || is_chromeos || is_android || is_fuchsia) {
   os_include = "linux"
 } else if (is_apple) {
   os_include = "mac"
 } else if (is_win) {
   os_include = "win32"
+} else if (is_gtos) {
+  # libxml's build reads a configure result: config.h and include/libxml/xmlversion.h. A GTOS one comes from libxml's own templates
+  # run against the GTOS SDK (//apps/native_content_build/libxml_gtos_config), and this file does not invent it. GN has no
+  # file_exists(), so the presence of the two headers is measured where they are generated and again by the compiler that includes
+  # them; this branch only refuses the empty default, which would otherwise surface as a confusing include failure.
+  assert(gtos_libxml_config_dir != "",
+         "Set gtos_libxml_config_dir to a GTOS libxml2 configuration directory")
+  os_include = gtos_libxml_config_dir
 }
 
 import("//third_party/libxml/libxml_visibility.gni")
