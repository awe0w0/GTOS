import("//build/config/ozone.gni")

declare_args() {
  gtos_content_probe_runtime_archive = ""
  gtos_content_window_interaction_test = false
  gtos_content_ozone_test = false
  gtos_content_mojo_test = false
  gtos_content_resources_test = false
}

assert(is_gtos && current_cpu == "x86")
assert(gtos_content_probe_runtime_archive != "")

group("content_with_base_probe") {
  testonly = true
  deps = [
    ":content_base_probe",
    "//content/shell:content_shell",
  ]
  if (gtos_content_ozone_test) {
    deps += [ ":content_ozone_probe" ]
  }
  if (gtos_content_mojo_test) {
    deps += [ ":content_mojo_probe" ]
  }
  if (gtos_content_resources_test) {
    deps += [ ":content_resources_probe" ]
  }
}

executable("content_base_probe") {
  testonly = true
  sources = [
    "//build/config/gtos/runtime/assert.cc",
    "//content/shell/app/entry_gtos.cc",
    "//content/shell/app/native-start.s",
    "gtos_content_asset_guest_test.cc",
    "gtos_content_base_platform_guest_test.cc",
    "gtos_content_condition_variable_guest_test.cc",
    "gtos_content_event_watcher_guest_test.cc",
  ]
  defines = [
    "GTOS_CONTENT_BASE_PLATFORM_TEST",
    "GTOS_CONTENT_CONDVAR_TEST",
    "GTOS_CONTENT_EVENT_WATCHER_TEST",
  ]
  if (gtos_content_window_interaction_test) {
    defines += [ "GTOS_CONTENT_WINDOW_INTERACTION_TEST=1" ]
  }
  inputs = [
    "//content/shell/app/native.ld",
    gtos_content_probe_runtime_archive,
  ]
  ldflags = [
    "-Wl,-T," + rebase_path("//content/shell/app/native.ld", root_build_dir),
    "-Wl,--gc-sections",
  ]
  libs = [ gtos_content_probe_runtime_archive ]
  deps = [
    "//base",
    "//base/version_info",
    "//build/config/gtos/runtime:ffmpeg_support",
  ]
}

if (gtos_content_ozone_test) {
  assert(gtos_ozone)
  executable("content_ozone_probe") {
    testonly = true
    sources = [
      "//build/config/gtos/runtime/assert.cc",
      "//content/shell/app/entry_gtos.cc",
      "//content/shell/app/native-start.s",
      "gtos_content_ozone_guest_test.cc",
    ]
    inputs = [
      "//content/shell/app/native.ld",
      gtos_content_probe_runtime_archive,
    ]
    ldflags = [
      "-Wl,-T," + rebase_path("//content/shell/app/native.ld", root_build_dir),
      "-Wl,--gc-sections",
    ]
    libs = [ gtos_content_probe_runtime_archive ]
    deps = [
      "//base",
      "//build/config/gtos/runtime:ffmpeg_support",
      "//build/config/gtos/runtime:native_environment",
      "//skia",
      "//ui/events",
      "//ui/gfx/geometry",
      "//ui/ozone",
      "//ui/platform_window",
    ]
  }
}

if (gtos_content_mojo_test) {
  executable("content_mojo_probe") {
    testonly = true
    sources = [
      "//build/config/gtos/runtime/assert.cc",
      "//content/shell/app/entry_gtos.cc",
      "//content/shell/app/native-start.s",
      "gtos_content_mojo_guest_test.cc",
    ]
    inputs = [
      "//content/shell/app/native.ld",
      gtos_content_probe_runtime_archive,
    ]
    ldflags = [
      "-Wl,-T," + rebase_path("//content/shell/app/native.ld", root_build_dir),
      "-Wl,--gc-sections",
    ]
    libs = [ gtos_content_probe_runtime_archive ]
    deps = [
      "//base",
      "//build/config/gtos/runtime:ffmpeg_support",
      "//build/config/gtos/runtime:native_environment",
      "//mojo/core/embedder",
      "//mojo/public/cpp/platform",
      "//mojo/public/cpp/system",
      "//third_party/boringssl",
    ]
  }
}

if (gtos_content_resources_test) {
  executable("content_resources_probe") {
    testonly = true
    sources = [
      "//build/config/gtos/runtime/assert.cc",
      "//content/shell/app/entry_gtos.cc",
      "//content/shell/app/native-start.s",
      "gtos_content_resources_guest_test.cc",
    ]
    inputs = [
      "//content/shell/app/native.ld",
      gtos_content_probe_runtime_archive,
    ]
    ldflags = [
      "-Wl,-T," + rebase_path("//content/shell/app/native.ld", root_build_dir),
      "-Wl,--gc-sections",
    ]
    libs = [ gtos_content_probe_runtime_archive ]
    deps = [
      "//base",
      "//base:i18n",
      "//build/config/gtos/runtime:ffmpeg_support",
      "//build/config/gtos/runtime:native_environment",
      "//content/shell:resources",
      "//third_party/icu",
      "//third_party/zlib/google:compression_utils",
      "//ui/base",
    ]
  }
}
