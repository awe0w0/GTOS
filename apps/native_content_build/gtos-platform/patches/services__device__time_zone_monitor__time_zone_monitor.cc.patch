@@ -12,6 +14,17 @@
 
 namespace device {
 
+#if BUILDFLAG(IS_GTOS)
+std::unique_ptr<TimeZoneMonitor> TimeZoneMonitor::Create(
+    scoped_refptr<base::SequencedTaskRunner> file_task_runner) {
+  auto monitor = base::WrapUnique(new TimeZoneMonitor);
+  // The native realtime ABI supplies UTC and has no timezone-change service.
+  monitor->UpdateIcuAndNotifyClients(
+      base::WrapUnique(icu::TimeZone::createTimeZone("UTC")));
+  return monitor;
+}
+#endif
+
 TimeZoneMonitor::TimeZoneMonitor()
     : timezone_(icu::TimeZone::createDefault()) {}
 
