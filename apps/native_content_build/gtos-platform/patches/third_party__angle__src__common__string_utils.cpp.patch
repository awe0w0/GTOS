 bool ReadFileToString(const std::string &path, std::string *stringOut)
 {
+#if defined(ANGLE_PLATFORM_GTOS)
+    FILE *inFile = fopen(path.c_str(), "rb");
+    if (inFile == nullptr)
+    {
+        return false;
+    }
+    std::string contents;
+    char buffer[4096];
+    size_t count;
+    while ((count = ANGLE_UNSAFE_BUFFERS(fread(buffer, 1, sizeof(buffer), inFile))) != 0)
+    {
+        if (count > contents.max_size() - contents.size())
+        {
+            fclose(inFile);
+            return false;
+        }
+        contents.append(buffer, count);
+    }
+    const bool readOk = ferror(inFile) == 0;
+    const bool closeOk = fclose(inFile) == 0;
+    if (!readOk || !closeOk)
+    {
+        return false;
+    }
+    *stringOut = std::move(contents);
+    return true;
+#else
     std::ifstream inFile(path.c_str(), std::ios::binary);
     if (inFile.fail())
     {
@@ -213,6 +241,7 @@ bool ReadFileToString(const std::string &path, std::string *stringOut)
 
