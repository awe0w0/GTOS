--- a/third_party/rust/flate2/v1/BUILD.gn
+++ b/third_party/rust/flate2/v1/BUILD.gn
@@ -90,6 +90,12 @@ cargo_crate("lib") {
   _configs_to_remove += [ "//build/config/compiler:default_optimization" ]
   _configs_to_add += [ "//build/config/compiler:optimize" ]
 
+  if (is_gtos) {
+    # Keep the DEFLATE stream adapters on the GTOS std I/O traits.
+    _configs_to_remove += [ "//build/config/compiler:disallow_unstable_features" ]
+    rustflags = [ "-Zallow-features=restricted_std" ]
+  }
+
   # Applying config changes.
   library_configs -= _configs_to_remove
   library_configs += _configs_to_add
