+bool ProcessIterator::CheckForNextProcess() {
+  if (returned_current_process_) {
+    return false;
+  }
+  returned_current_process_ = true;
+  entry_.pid_ = GetCurrentProcId();
+  if (CommandLine::InitializedForCurrentProcess()) {
+    const auto* command = CommandLine::ForCurrentProcess();
+    entry_.exe_file_ = command->GetProgram().BaseName().value();
+    entry_.cmd_line_args_ = command->argv();
+  }
+  return entry_.pid_ != kNullProcessId;
+}
+
+bool NamedProcessIterator::IncludeEntry() {
+  const auto& name = entry().exe_file_;
+  return !name.empty() &&
+         (use_prefix_match_ ? name.starts_with(executable_name_)
+                            : name == executable_name_) &&
+         ProcessIterator::IncludeEntry();
+}
