 bool sk_fidentical(FILE* a, FILE* b) {
+#if defined(__GTOS__)
+    // GTOS does not expose an inode identity for independently opened handles.
+    const int fd = a ? fileno(a) : -1;
+    struct stat status = {};
+    return fd >= 0 && b && fd == fileno(b) && fstat(fd, &status) == 0 &&
+           S_ISREG(status.st_mode);
+#else
     SkFILEID aID, bID;
     return sk_ino(a, &aID) && sk_ino(b, &bID)
            && aID.ino == bID.ino
            && aID.dev == bID.dev;
+#endif
 }
 
