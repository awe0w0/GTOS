+bool valid_descriptor_mode(const char *mode) {
+  if (!mode || (*mode != 'r' && *mode != 'w' && *mode != 'a')) return false;
+  bool binary = false;
+  bool update = false;
+  for (++mode; *mode; ++mode) {
+    if (*mode == 'b' && !binary) binary = true;
+    else if (*mode == '+' && !update) update = true;
+    else return false;
+  }
+  return true;
+}
