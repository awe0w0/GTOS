@@ -24,8 +27,25 @@ namespace {
 
 std::string ReadSetsFile(base::File sets_file) {
   std::string raw_sets;
+#if BUILDFLAG(IS_GTOS)
+  if (sets_file.Seek(base::File::FROM_BEGIN, 0) != 0) {
+    return {};
+  }
+  std::array<uint8_t, 4096> bytes;
+  for (;;) {
+    const auto count = sets_file.ReadAtCurrentPos(bytes);
+    if (!count) {
+      return {};
+    }
+    if (*count == 0) {
+      return raw_sets;
+    }
+    raw_sets.append(base::as_string_view(base::span(bytes).first(*count)));
+  }
+#else
   base::ScopedFILE file(FileToFILE(std::move(sets_file), "r"));
   return base::ReadStreamToString(file.get(), &raw_sets) ? raw_sets : "";
+#endif
 }
 
 }  // namespace
