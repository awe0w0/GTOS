--- a/third_party/perfetto/include/perfetto/base/time.h
+++ b/third_party/perfetto/include/perfetto/base/time.h
@@ -268,6 +268,34 @@ inline TimeNanos GetBootTimeNs() {
   return GetWallTimeNs();
 }
 
+#elif PERFETTO_BUILDFLAG(PERFETTO_OS_GTOS)
+
+constexpr clockid_t kWallTimeClockSource = CLOCK_MONOTONIC;
+
+inline TimeNanos GetTimeInternalNs(clockid_t clk_id) {
+  struct timespec ts = {};
+  PERFETTO_CHECK(clock_gettime(clk_id, &ts) == 0);
+  PERFETTO_CHECK(ts.tv_sec >= 0 && ts.tv_nsec >= 0 && ts.tv_nsec < 1000000000);
+  int64_t seconds_ns;
+  int64_t nanoseconds;
+  PERFETTO_CHECK(!__builtin_mul_overflow(ts.tv_sec, 1000000000LL, &seconds_ns));
+  PERFETTO_CHECK(!__builtin_add_overflow(seconds_ns, ts.tv_nsec, &nanoseconds));
+  return TimeNanos(nanoseconds);
+}
+
+inline TimeNanos GetWallTimeNs() {
+  return GetTimeInternalNs(kWallTimeClockSource);
+}
+
+// The native PIT clock is unadjusted. Suspend accounting is unavailable.
+inline TimeNanos GetWallTimeRawNs() { return GetWallTimeNs(); }
+inline TimeNanos GetBootTimeNs() { return GetWallTimeNs(); }
+
+// No per-thread/process CPU accounting service exists. As on WASM, zero
+// reports this unavailable measurement instead of substituting wall time.
+inline TimeNanos GetThreadCPUTimeNs() { return TimeNanos(0); }
+inline TimeNanos GetProcessCPUTimeNs() { return TimeNanos(0); }
+
 #else  // posix
 
 constexpr clockid_t kWallTimeClockSource = CLOCK_MONOTONIC;
