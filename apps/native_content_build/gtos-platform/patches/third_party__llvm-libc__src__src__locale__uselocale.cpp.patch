--- a/third_party/llvm-libc/src/src/locale/uselocale.cpp
+++ b/third_party/llvm-libc/src/src/locale/uselocale.cpp
@@ -9,15 +9,31 @@
 #include "src/locale/uselocale.h"
 #include "src/locale/locale.h"
 
+#include "hdr/locale_macros.h"
 #include "src/__support/common.h"
+#include "src/__support/libc_errno.h"
 #include "src/__support/macros/config.h"
 
 namespace LIBC_NAMESPACE_DECL {
 
 LLVM_LIBC_FUNCTION(locale_t, uselocale, (locale_t newloc)) {
+#if defined(__GTOS__)
+  // The C locale is immutable. Preserve the selected handle for each thread.
+  static thread_local locale_t current = LC_GLOBAL_LOCALE;
+  locale_t previous = current;
+  if (!newloc)
+    return previous;
+  if (newloc != LC_GLOBAL_LOCALE && newloc != &c_locale) {
+    libc_errno = EINVAL;
+    return nullptr;
+  }
+  current = newloc;
+  return previous;
+#else
   if (!newloc)
     return locale;
   return locale = newloc;
+#endif
 }
 
 } // namespace LIBC_NAMESPACE_DECL
