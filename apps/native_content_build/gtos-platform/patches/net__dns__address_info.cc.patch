+#if BUILDFLAG(IS_GTOS)
+struct GtosAddrinfo : addrinfo {
+  GtosAddrinfo(const IPEndPoint& endpoint, const addrinfo& hints)
+      : addrinfo{} {
+    ai_family = endpoint.GetSockAddrFamily();
+    ai_socktype = hints.ai_socktype;
+    ai_protocol = hints.ai_protocol;
+    ai_addr = reinterpret_cast<sockaddr*>(&address);
+    ai_addrlen = sizeof(address);
+    CHECK(endpoint.ToSockAddr(ai_addr, &ai_addrlen));
+  }
+
+  sockaddr_storage address{};
+  std::string canonical;
+  std::unique_ptr<GtosAddrinfo> next;
+};
+
+std::unique_ptr<GtosAddrinfo> ResolveGtosLocalName(
+    const std::string& host, const addrinfo& hints, int* os_error) {
+  const bool localhost = base::EqualsCaseInsensitiveASCII(host, "localhost") ||
+                         base::EqualsCaseInsensitiveASCII(host, "localhost.");
+  std::unique_ptr<GtosAddrinfo> first;
+  const auto add_address = [&](const IPAddress& ip) {
+    const IPEndPoint endpoint(ip, 0);
+    if (hints.ai_family != AF_UNSPEC &&
+        hints.ai_family != endpoint.GetSockAddrFamily()) {
+      return;
+    }
+    auto entry = std::make_unique<GtosAddrinfo>(endpoint, hints);
+    if (first) {
+      first->next = std::move(entry);
+      first->ai_next = first->next.get();
+    } else {
+      first = std::move(entry);
+    }
+  };
+  if (localhost) {
+    add_address(IPAddress::IPv6Localhost());
+    add_address(IPAddress::IPv4Localhost());
+  } else if (auto ip = IPAddress::FromIPLiteral(host)) {
+    add_address(*ip);
+  } else {
+    errno = ENOSYS;
+    *os_error = EAI_SYSTEM;
+    return nullptr;
+  }
+  if (!first) {
+    *os_error = EAI_NONAME;
+    return nullptr;
+  }
+  if (hints.ai_flags & AI_CANONNAME) {
+    first->canonical = localhost ? "localhost" : host;
+    first->ai_canonname = first->canonical.data();
+  }
+  *os_error = 0;
+  return first;
+}
+#endif
+
 const addrinfo* Next(const addrinfo* ai) {
   return ai->ai_next;
 }
