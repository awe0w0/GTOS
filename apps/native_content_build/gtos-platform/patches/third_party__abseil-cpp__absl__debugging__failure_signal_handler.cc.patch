+namespace absl {
+ABSL_NAMESPACE_BEGIN
+void InstallFailureSignalHandler(const FailureSignalHandlerOptions&) {
+  constexpr char message[] = "GTOS signal-handler API unavailable\n";
+  unsigned operation = GTOS_SYS_WRITE;
+  asm volatile("int $0x80"
+               : "+a"(operation)
+               : "b"(message), "c"(sizeof(message) - 1)
+               : "memory", "cc");
+  gtos::native::UnsupportedService();
+}
+namespace debugging_internal {
+const char* FailureSignalToString(int) {
+  gtos::native::UnsupportedService();
+}
+}  // namespace debugging_internal
+ABSL_NAMESPACE_END
