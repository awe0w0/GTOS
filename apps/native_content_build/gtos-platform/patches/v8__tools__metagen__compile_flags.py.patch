+def get_compile_args_from_ninja(build_dir: str,
+                                obj: str) -> tuple[list[str], str]:
+  """Read the exact command of one C++ edge without building its inputs."""
+  ninja = os.environ.get("GTOS_METAGEN_NINJA", "ninja")
+  try:
+    proc = subprocess.run(
+        [ninja, "-t", "commands", "-s", obj], cwd=build_dir,
+        capture_output=True, text=True, check=True)
+  except OSError as e:
+    raise RuntimeError(f"[metagen] could not start {ninja}: {e}") from e
+  except subprocess.CalledProcessError as e:
+    raise RuntimeError(
+        f"[metagen] could not query Ninja object {obj}: {e.stderr.strip()}") from e
+  lines = proc.stdout.splitlines()
+  if len(lines) != 1:
+    raise RuntimeError(f"[metagen] expected one compile command for {obj}")
+  args = shlex.split(lines[0])
+  if (not args or os.path.basename(args[0]) not in ("clang", "clang++") or
+      args.count("-c") != 1 or args[-2:] != ["-o", obj]):
+    raise RuntimeError(f"[metagen] unexpected C++ command for {obj}")
+  source = args[args.index("-c") + 1]
+  return _filter(args[1:], source), build_dir
+
