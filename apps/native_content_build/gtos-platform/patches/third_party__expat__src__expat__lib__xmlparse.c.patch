+#if defined(__GTOS__)
+static bool
+generate_gtos_hash_secret(struct sipkey *salt) {
+  uint32_t a, b, c, d;
+  __asm__ volatile("cpuid" : "=a"(a), "=b"(b), "=c"(c), "=d"(d)
+                   : "a"(0u), "c"(0u));
+  if (a < 1)
+    return false;
+  __asm__ volatile("cpuid" : "=a"(a), "=b"(b), "=c"(c), "=d"(d)
+                   : "a"(1u), "c"(0u));
+  if (!(c & (1u << 30)))
+    return false;
+
+  /* Match the GTOS native entropy policy. Never seed from time or PID. */
+  unsigned char *output = (unsigned char *)salt;
+  for (size_t i = 0; i < sizeof(*salt); i += sizeof(uint32_t)) {
+    uint32_t word;
+    unsigned char ready = 0;
+    for (unsigned attempt = 0; attempt < 10 && ! ready; ++attempt)
+      __asm__ volatile("rdrand %0; setc %1" : "=r"(word), "=qm"(ready) : : "cc");
+    if (! ready)
+      return false;
+    memcpy(output + i, &word, sizeof(word));
+  }
+  return true;
+}
