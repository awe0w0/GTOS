+#if defined(__GTOS__)
+bool BasicNetworkManager::CreateNetworks(
+    bool include_ignored,
+    std::vector<std::unique_ptr<Network>>* networks) const {
+  // The native network service only exposes loopback, which is ignored for ICE.
+  if (include_ignored) {
+    const auto address = GetLoopbackIP(AF_INET);
+    auto network = CreateNetwork("lo", "GTOS loopback", TruncateIP(address, 8),
+                                 8, ADAPTER_TYPE_LOOPBACK);
+    network->set_default_local_address_provider(this);
+    network->set_ignored(true);
+    network->AddIP(address);
+    networks->push_back(std::move(network));
+  }
+  return true;
+}
