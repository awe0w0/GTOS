   if (!IsThreadRefEqual(owning_thread_, CurrentThreadRef())) {
@@ -163,6 +171,8 @@ void RecursiveCriticalSection::Leave() const RTC_UNLOCK_FUNCTION() {
   RTC_DCHECK(CurrentThreadIsOwner());
 #if defined(WEBRTC_WIN)
   LeaveCriticalSection(&crit_);
+#elif defined(__GTOS__)
+  RTC_CHECK_EQ(std::__libcpp_recursive_mutex_unlock(&mutex_), 0);
