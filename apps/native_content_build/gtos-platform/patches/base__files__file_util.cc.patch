+#if BUILDFLAG(IS_GTOS)
+// Keep binary bytes (including NUL) and the same trailing-CR treatment as
+// TextContentsEqual on the other platforms. The caller checks ferror/feof.
+std::string ReadNativeLine(FILE* stream) {
+  std::string line;
+  for (int byte; (byte = fgetc(stream)) != EOF && byte != '\n';) {
+    line.push_back(static_cast<char>(byte));
+  }
+  const size_t last = line.find_last_not_of('\r');
+  line.resize(last == std::string::npos ? 0 : last + 1);
+  return line;
+}
+#endif
