+    sources += [
+      "src/crypto/rand/gtos.cc",
+      "src/crypto/thread_gtos.cc",
+    ]
+  }
   public = rebase_path(all_headers, ".", "src")
   friend = [ ":*" ]
   deps = [ "//third_party/boringssl/src/third_party/fiat:fiat_license" ]
