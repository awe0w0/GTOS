   return fci->makeTypeface(font_identity, SkFontMgr_New_Fontations_Empty());
+#elif BUILDFLAG(IS_GTOS)
+  // Fontconfig identifiers have no meaning in the packaged font manager.
+  return nullptr;
 #else
   NOTREACHED();
