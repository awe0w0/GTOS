+      # -MMD would omit them from both Ninja's dependency log and the evidence.
+      command = "$_clang $_common {{defines}} {{include_dirs}} {{cflags}} {{cflags_c}} -MD -MF $depfile -c {{source}} -o $output"
       description = "GTOS CC {{source}}"
-      outputs =
-          [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o" ]
+      outputs = [ output ]
     }
 
     tool("cxx") {
-      depfile = "{{output}}.d"
+      output = "{{target_out_dir}}/{{label_name}}/{{source_name_part}}.o"
+      depfile = "$output.d"
       depsformat = "gcc"
-      command = "$_clang -x c++ $_common -nostdinc++ -fno-exceptions -fno-rtti {{defines}} {{include_dirs}} {{cflags}} {{cflags_cc}} -MMD -MF {{output}}.d -c {{source}} -o {{output}}"
+      command = "$_clang -x c++ $_common -nostdinc++ -fno-exceptions -fno-rtti {{defines}} {{include_dirs}} {{cflags}} {{cflags_cc}} -MD -MF $depfile -c {{source}} -o $output"
       description = "GTOS CXX {{source}}"
-      outputs =
-          [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o" ]
+      outputs = [ output ]
     }
 
     tool("asm") {
+      depfile = "{{output}}.d"
+      depsformat = "gcc"
       command =
-          "$_clang --target=$_triple {{asmflags}} -c {{source}} -o {{output}}"
+          "$_clang --target=$_triple -nostdinc {{defines}} {{include_dirs}} {{asmflags}} -MD -MF {{output}}.d -c {{source}} -o {{output}}"
       description = "GTOS ASM {{source}}"
       outputs =
           [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o" ]
@@ -56,7 +63,13 @@ template("gtos_freestanding_toolchain") {
     }
 
     tool("link") {
-      command = "$gtos_clang_bin/ld.lld -m $_elf {{ldflags}} -o {{output}} {{inputs}} {{solibs}} {{libs}}"
+      if (gtos_content_link_via_clang) {
