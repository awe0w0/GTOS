     tool("cc") {
-      depfile = "{{output}}.d"
+      output = "{{target_out_dir}}/{{label_name}}/{{source_name_part}}.o"
+      depfile = "$output.d"
       depsformat = "gcc"
-      command = "$_clang $_common {{defines}} {{include_dirs}} {{cflags}} {{cflags_c}} -MMD -MF {{output}}.d -c {{source}} -o {{output}}"
