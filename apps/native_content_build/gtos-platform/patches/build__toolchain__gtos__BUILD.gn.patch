--- a/build/toolchain/gtos/BUILD.gn
+++ b/build/toolchain/gtos/BUILD.gn
@@ -8,6 +8,9 @@ declare_args() {
   # Absolute directory of the reviewed official Clang/LLD/llvm-ar binaries.
   # There is no host compiler fallback for GTOS target objects.
   gtos_clang_bin = ""
+  # Content's common configs express ELF linker options through Clang.
+  # Standalone GTOS targets retain the raw LLD command by default.
+  gtos_content_link_via_clang = false
 }
 
 assert(gtos_clang_bin != "", "Set gtos_clang_bin to the pinned official Clang")
@@ -22,26 +25,30 @@ template("gtos_freestanding_toolchain") {
