   fd_.reset();
 #endif
 }
@@ -233,7 +257,7 @@ void PlatformHandle::release() {
   std::ignore = mach_receive_.release();
 #endif
 
-#if BUILDFLAG(IS_POSIX) || BUILDFLAG(IS_FUCHSIA)
+#if BUILDFLAG(IS_POSIX) || BUILDFLAG(IS_FUCHSIA) || BUILDFLAG(IS_GTOS)
   std::ignore = fd_.release();
 #endif
 }
@@ -252,6 +276,8 @@ PlatformHandle PlatformHandle::Clone() const {
   }
   CHECK(!is_valid_mach_receive()) << "Cannot clone Mach receive rights";
   return PlatformHandle(CloneFD(fd_));
+#elif BUILDFLAG(IS_GTOS)
+  return is_valid_fd() ? PlatformHandle(CloneFD(fd_)) : PlatformHandle();
 #elif BUILDFLAG(IS_POSIX)
   return PlatformHandle(CloneFD(fd_));
 #endif
