+  assert(gtos_rust_target_json != "", "Set the GTOS Rust target JSON")
+  rust_target_json = gtos_rust_target_json
+}
 if (is_linux || is_chromeos) {
   if (current_cpu == "arm64") {
     rust_abi_target = "aarch64-unknown-linux-gnu"
@@ -440,6 +449,10 @@ rustc_wrapper_inputs = [
   "//build/rust/gni_impl/rustc_wrapper.py",
 ]
 
+if (is_gtos) {
+  rustc_wrapper_inputs += [ rust_target_json ]
+}
+
 if (host_os == "win") {
   rustc_wrapper_inputs += [ "//third_party/rust-toolchain/bin/rustc.exe" ]
 } else {
