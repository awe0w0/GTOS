@@ -20,6 +20,8 @@
 
 #if BUILDFLAG(IS_WIN)
 #include "base/win/windows_types.h"
+#elif BUILDFLAG(IS_GTOS)
+#include <__external_threading>
 #elif BUILDFLAG(IS_POSIX) || BUILDFLAG(IS_FUCHSIA)
 #include <errno.h>
 #include <pthread.h>
@@ -60,6 +62,8 @@ class BASE_EXPORT LockImpl {
 
 #if BUILDFLAG(IS_WIN)
   using NativeHandle = CHROME_SRWLOCK;
+#elif BUILDFLAG(IS_GTOS)
+  using NativeHandle = std::__libcpp_mutex_t;
 #elif BUILDFLAG(IS_POSIX) || BUILDFLAG(IS_FUCHSIA)
   using NativeHandle = pthread_mutex_t;
 #endif
@@ -128,6 +132,16 @@ void LockImpl::Unlock() {
