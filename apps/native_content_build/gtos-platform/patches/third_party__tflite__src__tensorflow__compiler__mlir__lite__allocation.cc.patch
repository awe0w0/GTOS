+void FileCopyAllocation::CopyFromDescriptor(int fd) {
+  struct stat info {};
+  if (fstat(fd, &info) != 0 || !S_ISREG(info.st_mode) || info.st_size < 0 ||
+      static_cast<uint64_t>(info.st_size) > std::numeric_limits<size_t>::max()) {
+    TF_LITE_REPORT_ERROR(error_reporter_, "Invalid model descriptor %d.", fd);
+    return;
+  }
+  const size_t size = static_cast<size_t>(info.st_size);
+  std::unique_ptr<char[]> buffer(new (std::nothrow) char[size]);
+  if (!buffer) {
+    TF_LITE_REPORT_ERROR(error_reporter_, "Could not allocate model copy.");
+    return;
+  }
+  for (size_t offset = 0; offset < size;) {
+    const size_t chunk = std::min<size_t>(size - offset, GTOS_FILE_TRANSFER_LIMIT);
+    const ssize_t count = gtos_read_at(fd, buffer.get() + offset, chunk,
+                                      static_cast<off_t>(offset));
+    if (count <= 0 || static_cast<size_t>(count) > chunk) {
+      TF_LITE_REPORT_ERROR(error_reporter_, "Could not read model descriptor %d.", fd);
+      return;
+    }
+    offset += static_cast<size_t>(count);
+  }
+  copied_buffer_ = std::move(buffer);
+  buffer_size_bytes_ = size;
+}
+#endif
+
 FileCopyAllocation::~FileCopyAllocation() = default;
 
 const void* FileCopyAllocation::base() const { return copied_buffer_.get(); }
