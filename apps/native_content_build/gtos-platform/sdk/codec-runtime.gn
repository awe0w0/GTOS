import("ffmpeg/libc_sources.gni")

source_set("codec_support") {
  assert(is_gtos && current_cpu == "x86")
  sources = [
    "codec_once.cc",
    "setjmp_i386.S",
    "tanh.cc",
  ]
  deps = [ ":codec_qsort" ]
}

source_set("codec_qsort") {
  assert(is_gtos && current_cpu == "x86")
  sources = [ "//third_party/llvm-libc/src/src/stdlib/qsort.cpp" ]
  include_dirs = [ "//third_party/llvm-libc/src" ]
  defines = [
    "LIBC_NAMESPACE=__llvm_libc_cr",
    "LIBC_COPT_PUBLIC_PACKAGING=1",
  ]
}

source_set("native_threads") {
  assert(is_gtos && current_cpu == "x86")
  sources = [
    "//tools/gtos_native_sdk/native-thread.cc",
    "//tools/gtos_native_sdk/native-thread.h",
    "//v8/tools/gtos_isolate_diagnostic/runtime/condition-variable-core.cc",
    "//v8/tools/gtos_isolate_diagnostic/runtime/gtos-thread.cc",
  ]
  include_dirs = [ "//v8" ]
  defines = [
    "V8_HAVE_TARGET_OS",
    "V8_TARGET_OS_GTOS",
    "V8_TARGET_ARCH_IA32",
  ]
  deps = [ ":native_libcpp_thread" ]
}

source_set("native_libcpp_thread") {
  assert(is_gtos && current_cpu == "x86")
  sources = [
    "//third_party/libc++/src/src/atomic.cpp",
    "//third_party/libc++/src/src/error_category.cpp",
    "//third_party/libc++/src/src/future.cpp",
    "//third_party/libc++/src/src/stdexcept.cpp",
    "//third_party/libc++/src/src/system_error.cpp",
    "//third_party/libc++/src/src/thread.cpp",
  ]
  # The upstream ABI pragma region also lists attributes these TUs do not use.
  cflags_cc = [ "-Wno-pragma-clang-attribute" ]
  # The libc++ error categories deliberately use no-op exit destructors.
  configs += [ "//build/config/compiler:no_exit_time_destructors" ]
  deps = [
    ":native_cxx_abi",
    ":native_error_strings",
  ]
}

source_set("native_error_strings") {
  assert(is_gtos && current_cpu == "x86")
  sources = [
    "//third_party/llvm-libc/src/src/__support/StringUtil/error_to_string.cpp",
    "//third_party/llvm-libc/src/src/string/strerror_r.cpp",
  ]
  include_dirs = [ "//third_party/llvm-libc/src" ]
  defines = [
    "LIBC_NAMESPACE=__llvm_libc_cr",
    "LIBC_COPT_PUBLIC_PACKAGING=1",
  ]
}

source_set("native_cxx_abi") {
  assert(is_gtos && current_cpu == "x86")
  sources = [
    "//third_party/libc++/src/src/exception.cpp",
    "//third_party/libc++abi/src/src/cxa_aux_runtime.cpp",
    "//third_party/libc++abi/src/src/cxa_default_handlers.cpp",
    "//third_party/libc++abi/src/src/cxa_handlers.cpp",
    "//third_party/libc++abi/src/src/cxa_noexception.cpp",
    "//third_party/libc++abi/src/src/private_typeinfo.cpp",
    "//third_party/libc++abi/src/src/stdlib_exception.cpp",
    "//third_party/libc++abi/src/src/stdlib_typeinfo.cpp",
  ]
  include_dirs = [
    "//third_party/libc++/src/src",
    "//third_party/libc++abi/src/include",
    "//third_party/libunwind/src/include",
  ]
  defines = [
    "LIBCXX_BUILDING_LIBCXXABI",
    "_LIBCPP_ENABLE_CXX17_REMOVED_UNEXPECTED_FUNCTIONS",
  ]
  configs -= [
    "//build/config/compiler:chromium_code",
    "//build/config/compiler:no_rtti",
  ]
  configs += [
    "//build/config/compiler:no_chromium_code",
    "//build/config/compiler:rtti",
  ]
}

source_set("native_file_output") {
  assert(is_gtos && current_cpu == "x86")
  sources = [
    "//tools/gtos_native_sdk/file-output.cc",
    "//tools/gtos_native_sdk/file-output.hpp",
  ]
}

source_set("native_file_input") {
  assert(is_gtos && current_cpu == "x86")
  sources = [
    "//tools/gtos_native_sdk/file-input.cc",
    "//tools/gtos_native_sdk/file-input.hpp",
  ]
}

source_set("native_locale") {
  assert(is_gtos && current_cpu == "x86")
  sources = [
    "//third_party/llvm-libc/src/src/locale/localeconv.cpp",
    "//third_party/llvm-libc/src/src/locale/setlocale.cpp",
  ]
  include_dirs = [ "//third_party/llvm-libc/src" ]
  defines = [
    "LIBC_NAMESPACE=__llvm_libc_cr",
    "LIBC_COPT_PUBLIC_PACKAGING=1",
    "LIBC_FULL_BUILD=1",
  ]
}

source_set("native_pthread") {
  assert(is_gtos && current_cpu == "x86")
  sources = [
    "ffmpeg/pthread.cc",
    "ffmpeg/pthread.h",
  ]
  deps = [
    ":native_threads",
    "//v8:v8_libbase",
  ]
}

source_set("native_environment") {
  assert(is_gtos && current_cpu == "x86")
  sources = [
    "//third_party/llvm-libc/src/src/stdlib/environ_internal.cpp",
    "//third_party/llvm-libc/src/src/stdlib/getenv.cpp",
    "//third_party/llvm-libc/src/src/stdlib/linux/setenv.cpp",
    "//third_party/llvm-libc/src/src/stdlib/linux/unsetenv.cpp",
    "//tools/gtos_native_sdk/environment/environment.cc",
  ]
  include_dirs = [
    "//tools/gtos_native_sdk/environment",
    "//third_party/llvm-libc/src",
  ]
  defines = [
    "LIBC_NAMESPACE=__llvm_libc_cr",
    "LIBC_COPT_PUBLIC_PACKAGING=1",
  ]
}

source_set("native_file_api") {
  assert(is_gtos && current_cpu == "x86")
  sources = [
    "directory.cpp",
    "posix_file.cpp",
  ]
}

source_set("native_base_libc") {
  assert(is_gtos && current_cpu == "x86")
  sources = [
    "exit_gtos.cc",
    "fnmatch_gtos.cc",
    "perror_gtos.cc",
    "putc_gtos.cc",
    "//third_party/llvm-libc/src/src/ctype/isalpha.cpp",
    "//third_party/llvm-libc/src/src/ctype/isgraph.cpp",
    "//third_party/llvm-libc/src/src/math/generic/nextafter.cpp",
    "//third_party/llvm-libc/src/src/stdlib/atol.cpp",
    "//third_party/llvm-libc/src/src/string/strnlen.cpp",
    "//third_party/llvm-libc/src/src/time/gmtime.cpp",
    "//third_party/llvm-libc/src/src/wchar/wcschr.cpp",
  ]
  include_dirs = [ "//third_party/llvm-libc/src" ]
  defines = [
    "LIBC_NAMESPACE=__llvm_libc_cr",
    "LIBC_COPT_PUBLIC_PACKAGING=1",
  ]
  deps = [
    ":native_environment",
    ":native_error_strings",
    ":native_file_api",
    ":native_locale",
  ]
}

source_set("native_address_text") {
  assert(is_gtos && current_cpu == "x86")
  sources = [ "address_text.cc" ]
  deps = [ "//url" ]
}

source_set("ffmpeg_support") {
  assert(is_gtos && current_cpu == "x86")
  sources = [
    "ffmpeg/clock.cc",
    "ffmpeg/hyperbolic.cc",
  ] + gtos_ffmpeg_libc_sources
  include_dirs = [
    "//third_party/llvm-libc/src",
    "//v8",
  ]
  defines = [
    "LIBC_NAMESPACE=__llvm_libc_cr",
    "LIBC_COPT_PUBLIC_PACKAGING=1",
  ]
  deps = [
    ":codec_support",
    ":native_environment",
    ":native_error_strings",
    ":native_file_api",
    ":native_pthread",
    "//v8:v8_libbase",
  ]
}
