# Real C clock_gettime and pinned LLVM external errno with native thread cells.
if (gtos_isolate_compile_diagnostic && current_os == "gtos") {
  v8_source_set("native_c_clock") {
    assert(current_cpu == "x86")
    configs = []
    include_dirs = [ "//third_party/llvm-libc/src" ]
    # External errno cells allocate nothing, including on heap OOM. Other libc
    # consumers use the same Errno class ABI; mode3/4 headers have identical
    # declarations and their actual read/write provider is this mode4 object.
    defines = [ "LIBC_NAMESPACE=__llvm_libc_cr", "LIBC_ERRNO_MODE=4" ]
    sources = [
      "runtime/clock-gettime.cc",
      "runtime/nanosleep.cc",
      "//third_party/llvm-libc/src/src/errno/libc_errno.cpp",
    ]
    deps = [ ":native_runtime" ]
  }
}


