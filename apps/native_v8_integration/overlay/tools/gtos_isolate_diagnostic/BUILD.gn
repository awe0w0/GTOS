    sources = [
      "native-exit/llvm-libc/src/stdlib/atexit.cpp",
      "runtime/process-exit.cc",
    ]
    deps = [ ":native_file_libc", ":native_runtime" ]
  }
}

executable("native_embedder") {
  assert(gtos_isolate_compile_diagnostic && current_os == "gtos" && current_cpu == "x86")
  configs = []
  configs += [ "//build/config/clang:compiler_builtins" ]
  sources = [ "native-entry.cc", "native-start.s" ]
  deps = [ ":consumer", "//:v8", "//:v8_libplatform", ":native_stream_libcxx" ]
  deps += [ ":native_string_libc", ":native_printf_libc" ]
  deps += [ ":native_cpp_libcxx" ]
  deps += [ ":native_file_libc" ]
  deps += [ ":native_diagnostic_libcxx" ]
  deps += [ ":native_once_libcxx" ]
  deps += [ ":native_ctype_libc" ]
  deps += [ ":native_alloc_printf_libc" ]
  deps += [ ":native_guard_libcxxabi" ]
  deps += [ ":native_locale_libc" ]
  deps += [ ":native_time_format_libc" ]
  deps += [ ":native_chrono_libcxx" ]
  deps += [ ":native_wide_libc" ]
  deps += [ ":native_runtime_error_libcxx" ]
  deps += [ ":native_scanf_libc" ]
  deps += [ ":native_sync_libcxx" ]
  deps += [ ":native_output_libc" ]
  deps += [ ":native_numeric_libc" ]
