defines = -D__GTOS__=1
include_dirs = -I../source
cflags =
cflags_c =
root_out_dir = .
target_out_dir = obj/tools/gtos
target_output_name = platform_identity_probe

build obj/tools/gtos/platform_identity_probe.platform_identity.o: cc ../source/tools/gtos/platform_identity.c | ../source/build/config/unsafe_buffers_paths.txt ../source/build/config/raw_ptr_plugin_config.yaml
  source_file_part = platform_identity.c
  source_name_part = platform_identity

build phony/tools/gtos/platform_identity_probe.linkdeps: phony obj/tools/gtos/platform_identity_probe.platform_identity.o
build phony/tools/gtos/platform_identity_probe: phony phony/tools/gtos/platform_identity_probe.linkdeps
